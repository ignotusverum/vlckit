From e890740682ae4ddf02ce90ed3fd1b78f091afd0a Mon Sep 17 00:00:00 2001
From: "Vlad Z." <vlad@octoent.com>
Date: Sun, 11 Oct 2026 21:55:33 -0700
Subject: [PATCH 19/21] apple: drop modules a player-only app cannot reach

Remove stream output, muxers and encoders, non-HTTP network accesses and
service discovery, and rarely used formats and audio effects from the
iOS, tvOS and xrOS static module lists. Dead stripping then drops the
contrib code only those modules used.

Measured on the iOS device slice: about 5.2 MB of code and data.
---
 extras/package/apple/build.conf | 127 +++++++++++++++++++++++++++++++-
 1 file changed, 124 insertions(+), 3 deletions(-)

diff --git a/extras/package/apple/build.conf b/extras/package/apple/build.conf
index 0cf35f599b..8efc77e16d 100644
--- a/extras/package/apple/build.conf
+++ b/extras/package/apple/build.conf
@@ -252,14 +252,135 @@ export VLC_MODULE_REMOVAL_LIST_BASE=(
 # Additional modules to remove for macOS
 export VLC_MODULE_REMOVAL_LIST_MACOSX=()
 
