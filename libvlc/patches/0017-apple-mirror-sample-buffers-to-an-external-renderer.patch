From 156b3b51ba4107937bf492f1def493e90c10c969 Mon Sep 17 00:00:00 2001
From: "Vlad Z." <vlad@octoent.com>
Date: Fri, 9 Oct 2026 10:25:12 -0700
Subject: [PATCH] apple: mirror sample buffers to an external renderer

When the drawable responds to vlcExternalSampleBufferRenderer and returns
an AVSampleBufferVideoRenderer, every frame enqueued on the display layer
is also enqueued on that renderer. visionOS uses this to feed a RealityKit
VideoPlayerComponent, so the same decoded frames can be shown on a large
screen inside an immersive space without a second decode or connection.
---
 .../video_output/apple/VLCSampleBufferDisplay.m  | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/modules/video_output/apple/VLCSampleBufferDisplay.m b/modules/video_output/apple/VLCSampleBufferDisplay.m
index c59e87bdbf..d88e91b88e 100644
--- a/modules/video_output/apple/VLCSampleBufferDisplay.m
+++ b/modules/video_output/apple/VLCSampleBufferDisplay.m
@@ -36,6 +36,7 @@
 
 #import <AVFoundation/AVFoundation.h>
 #import <AVKit/AVKit.h>
+#import <objc/message.h>
 
 #include "../../codec/vt_utils.h"
 #include "vlc_pip_controller.h"
@@ -1169,6 +1170,21 @@ static void RenderPicture(vout_display_t *vd, picture_t *pic, vlc_tick_t date) {
         [sys.displayLayer enqueueSampleBuffer:sampleBuffer];
     }
 
+    if (@available(macOS 14.0, iOS 17.0, tvOS 17.0, visionOS 1.0, *)) {
+        id window = sys.window;
+        SEL selector = NSSelectorFromString(@"vlcExternalSampleBufferRenderer");
+        if ([window respondsToSelector:selector]) {
+            AVSampleBufferVideoRenderer *external =
+                ((AVSampleBufferVideoRenderer *(*)(id, SEL))objc_msgSend)(window, selector);
+            if (external) {
+                if (external.status == AVQueuedSampleBufferRenderingStatusFailed
+                 || external.requiresFlushToResumeDecoding)
+                    [external flush];
+                [external enqueueSampleBuffer:sampleBuffer];
+            }
+        }
+    }
+
     CFRelease(sampleBuffer);
 }
 
